# Example environment variables for EIDOS
# Copy this file to .env and fill in your own values.

# Telegram
EIDOS_TELEGRAM_TOKEN=
EIDOS_TELEGRAM_ADMIN_ID=
EIDOS_TELEGRAM_CHAT_ID=
EIDOS_TELEGRAM_ALLOWED=

# OpenAI / LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# API / database
DATABASE_URL=
MONGODB_URI=
EIDOS_API_KEY=
EIDOS_JWT_SECRET=
EIDOS_SECRET_KEY=

# Bridge (puente HTTP) y P2P — antes hardcodeados, ahora desde entorno
EIDOS_BRIDGE_URL=http://localhost:8003
EIDOS_BRIDGE_KEY=
EIDOS_P2P_SECRET=

# Optional service tokens
DISCORD_BOT_TOKEN=
LINE_CHANNEL_SECRET=
ZALO_WEBHOOK_SECRET=

# Ollama / local models
OLLAMA_URL=http://127.0.0.1:11434
EIDOS_FAST_MODEL=
