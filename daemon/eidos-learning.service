[Unit]
Description=EIDOS Learning Daemon
After=network-online.target
Wants=network-online.target

# Portable template. Replace EIDOS_ROOT and EIDOS_VENV in a host-local copy
# before installing under /etc/systemd/system. Do not commit host-specific paths.
[Service]
Type=simple
WorkingDirectory=EIDOS_ROOT
ExecStart=EIDOS_VENV/bin/python EIDOS_ROOT/daemon/eidos_learning_daemon.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.eidos

[Install]
WantedBy=multi-user.target
