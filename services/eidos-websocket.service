[Unit]
Description=EIDOS WebSocket Server — Streaming en tiempo real
After=network.target
Wants=eidos-bridge.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m core.eidos_websocket
WorkingDirectory=%h/EIDOS
Environment=PYTHONPATH=%h/EIDOS
Restart=always
RestartSec=5
StandardOutput=append:%h/.eidos/websocket.log
StandardError=append:%h/.eidos/websocket.log

[Install]
WantedBy=default.target
