[Unit]
Description=EIDOS Identity — Sleep diario y consolidación autobiográfica
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -c "from core.eidos_identity import get_identity; idn = get_identity(); result = idn.sleep(); print(f'Sleep #{result[\"sleep_cycle\"]} — independencia: {result[\"independence_pct\"]}%')"
WorkingDirectory=%h/EIDOS
Environment=PYTHONPATH=%h/EIDOS
StandardOutput=append:%h/.eidos/identity_sleep.log
StandardError=append:%h/.eidos/identity_sleep.log
