#!/usr/bin/env python3
"""
EIDOS CLI - Wrapper Global
Integración completa: Gateway + Colony + Ollama
"""

import sys
import subprocess
import asyncio
import argparse
from pathlib import Path

# Resolve the checkout/install location instead of binding EIDOS to SER's machine.
EIDOS_ROOT = Path(__file__).resolve().parents[1]
if str(EIDOS_ROOT) not in sys.path:
    sys.path.insert(0, str(EIDOS_ROOT))


def check_ollama():
    """Verificar que Ollama está corriendo"""
    try:
        result = subprocess.run(
            ["curl", "-s", "http://localhost:11434/api/tags"],
            capture_output=True, timeout=5
        )
        return result.returncode == 0
    except Exception:
        return False


def start_ollama():
    """Iniciar Ollama si no está corriendo"""
    if not check_ollama():
        print("🔄 Iniciando Ollama...")
        subprocess.Popen(
            ["ollama", "serve"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        import time
        time.sleep(3)
        if check_ollama():
            print("✅ Ollama iniciado")
        else:
            print("⚠️ No se pudo iniciar Ollama automáticamente")


def main():
    parser = argparse.ArgumentParser(description="EIDOS CLI")
    parser.add_argument(
        "command", nargs="?", default="chat",
        help="Comando: cli, chat, libre, gateway, config, status, tools, capabilities"
    )
    parser.add_argument(
        "--model", default="qwen2.5-coder:1.5b",
        help="Modelo Ollama a usar"
    )
    parser.add_argument(
        "--platforms", default="local",
        help="Plataformas: local,telegram,discord,slack"
    )

    args = parser.parse_args()

    # Introspection and the shared terminal must work without forcing a model daemon.
    model_commands = {"chat", "libre", "gateway"}
    if args.command in model_commands:
        start_ollama()

    if args.command == "cli":
        from bin.eidos_agents_terminal import SharedAgentsTerminal
        SharedAgentsTerminal().cmdloop()

    elif args.command == "chat":
        from core.colony_interactive import interactive_chat
        interactive_chat(model=args.model)

    elif args.command == "libre":
        from core.eidos_libre import EidosLibre
        libre = EidosLibre()
        libre.start()
        print("EIDOS Libre activo. Ctrl+C para detener.")
        try:
            while libre.is_running():
                import time
                time.sleep(1)
        except KeyboardInterrupt:
            libre.stop()

    elif args.command == "gateway":
        from main import EidosIntegratedSystem
        asyncio.run(EidosIntegratedSystem().start())

    elif args.command == "config":
        from cli.config_cmd import config_cli
        config_cli()

    elif args.command == "status":
        print("🤖 EIDOS Status:")
        print(f"   Ollama: {'✅' if check_ollama() else '❌'}")
        print(f"   Modelo: {args.model}")
        print("   Gateway: Listo")

    elif args.command in {"tools", "capabilities"}:
        import json
        from core.runtime_hub import get_runtime_hub
        print(json.dumps(get_runtime_hub().capability_catalog(), indent=2, default=str))

    else:
        print(f"Comando desconocido: {args.command}")
        print("Usa: eidos [cli|chat|libre|gateway|config|status|tools|capabilities]")


if __name__ == "__main__":
    main()
